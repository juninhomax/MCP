FROM python:3.11-slim

LABEL maintainer="MCP Slave Team"
LABEL description="MCP Slave Linux - Execution Agent"

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    docker.io \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY slaves/linux/requirements.txt ./slaves/linux/
COPY shared/ ./shared/

# Install Python dependencies
RUN pip install --no-cache-dir -r slaves/linux/requirements.txt

# Copy application code
COPY slaves/linux/ ./slaves/linux/

# Create non-root user
RUN useradd -m -u 1000 mcpslave && \
    chown -R mcpslave:mcpslave /app

USER mcpslave

WORKDIR /app/slaves/linux

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

CMD ["python", "main.py"]
